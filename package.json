{
  "name": "@hytaleone/votifier",
  "version": "1.0.0",
  "description": "Send votes to Hytale and Minecraft servers using Votifier V1 and V2 (NuVotifier) protocols",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "hytale",
    "minecraft",
    "votifier",
    "nuvotifier",
    "vote",
    "server-list",
    "bukkit",
    "spigot",
    "paper"
  ],
  "author": "HytaleOne",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/HytaleOne/votifier-js"
  },
  "homepage": "https://hytale.one",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  }
}
